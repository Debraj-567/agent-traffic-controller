import { askSarvam } from "../sarvam/client.js";

export class AIAgent {
  constructor(id, role) {
    this.id = id;
    this.role = role;
    this.status = "idle";
    this.lastResult = null;
  }

  async execute(task, context = "", { signal } = {}) {
    if (this.status === "working") {
      throw new Error(`${this.id} is already working`);
    }

    if (signal?.aborted) {
      throw new Error("Agent execution cancelled before starting");
    }

    this.status = "working";

    try {
      console.log(`\n[${this.id}] Starting task: ${task}`);

      const result = await askSarvam([
        {
          role: "system",
          content: `
You are ${this.id}, a specialist AI agent.

Your role: ${this.role}.

PROJECT CONTEXT:
We are building an Agent Traffic Controller: a software system
that coordinates multiple AI agents and prevents resource conflicts,
circular waits, deadlocks, scheduling problems and execution failures.

IMPORTANT:
This is NOT a road traffic management system.
Do not discuss roads, intersections, vehicles or traffic lights
unless explicitly asked.

Perform only your assigned role.
Use the context from previous agents.
Be technically precise.
Clearly distinguish recommendations from implemented functionality.
          `.trim()
        },
        {
          role: "user",
          content: `
TASK:
${task}

PREVIOUS AGENT OUTPUT:
${context || "No previous output."}

Provide a structured technical response.
          `.trim()
        }
      ], { signal });

      this.lastResult = result;
      this.status = "idle";

      return {
        agentId: this.id,
        role: this.role,
        status: "completed",
        result
      };

    } catch (error) {
      this.status =
        error.name === "AbortError" ? "cancelled" : "failed";

      throw error;

    } finally {
      if (this.status === "working") {
        this.status = "idle";
      }
    }
  }
}
